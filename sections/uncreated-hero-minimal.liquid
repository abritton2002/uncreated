{% style %}
  #uncreated-hero-{{ section.id }} {
    min-height: {{ section.settings.hero_height }}vh;
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #uncreated-hero-{{ section.id }} .hero__bg-image {
    filter: grayscale(100%) contrast(1.2);
    opacity: 0.9;
    transition: filter 0.6s ease;
  }

  #uncreated-hero-{{ section.id }}:hover .hero__bg-image {
    filter: grayscale(50%) contrast(1.1);
  }

  #uncreated-hero-{{ section.id }} .hero__background {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }

  #uncreated-hero-{{ section.id }} .hero__bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
{% endstyle %}

<section
  id="uncreated-hero-{{ section.id }}"
  class="uncreated-hero"
  data-section-id="{{ section.id }}"
  data-section-type="uncreated-hero"
>
  {%- if section.settings.background_image != blank -%}
    <div class="hero__background">
      {{
        section.settings.background_image
        | image_url: width: 2000
        | image_tag: loading: 'eager', class: 'hero__bg-image', fetchpriority: 'high'
      }}
    </div>
  {%- endif -%}

  <div class="hero__content">
    {%- if section.settings.show_overlay_text -%}
      <div class="hero__overlay-text">
        {%- if section.settings.logo != blank -%}
          <div class="hero__logo">
            {{ section.settings.logo | image_url: width: 400 | image_tag: loading: 'eager' }}
          </div>
        {%- endif -%}

        {%- if section.settings.title != blank -%}
          <h1 class="hero__title">{{ section.settings.title }}</h1>
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <p class="hero__overlay-subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}

        {%- if section.settings.show_cta -%}
          <button
            class="hero__overlay-cta"
            onclick="{% if section.settings.cta_link != blank %}window.location.href='{{ section.settings.cta_link }}'{% else %}document.querySelector('.uncreated-countdown, .uncreated-product, [id*=product]').scrollIntoView({ behavior: 'smooth' }){% endif %}"
          >
            {{ section.settings.cta_text }}
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_scroll_indicator -%}
      <div class="hero__scroll-indicator">
        <div class="scroll-line"></div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Uncreated Hero",
  "class": "section-uncreated-hero",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "range",
      "id": "hero_height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Hero Height",
      "default": 100
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_overlay_text",
      "label": "Show Content",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo (optional)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "UNCREATED"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Created by the Uncreated One"
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show CTA Button",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "ENTER DROP"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link (optional)",
      "info": "Leave blank to scroll to product/countdown"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_indicator",
      "label": "Show Scroll Indicator",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Uncreated Hero"
    }
  ]
}
{% endschema %}
