{% comment %}
  Renders a continuous scrolling ticker (sports bar style).
  Infinitely scrolls content from right to left.

  Usage:
  {% render 'header-ticker-menu' %}
{% endcomment %}

<nav class="header__ticker-menu" role="navigation" aria-label="Main navigation">
  <div class="header__ticker-container">
    <div class="header__ticker-track">
      {%- comment -%} Repeat content 8 times for seamless infinite scroll {%- endcomment -%}
      {%- for i in (1..8) -%}
        <div class="header__ticker-content"{% if i > 1 %} aria-hidden="true"{% endif %}>
          {%- comment -%} Brand announcements {%- endcomment -%}
          <span class="header__ticker-item header__ticker-item--announcement">DEAR UNCREATED ONES</span>
          <span class="header__ticker-separator" aria-hidden="true">/</span>
          <span class="header__ticker-item header__ticker-item--announcement">WE ARE COMING BACK</span>
          <span class="header__ticker-separator" aria-hidden="true">/</span>

          {%- comment -%} Navigation links {%- endcomment -%}
          {%- for link in section.settings.menu.links -%}
            <a
              href="{{ link.url }}"
              class="header__ticker-item{% if link.current %} header__ticker-item--active{% endif %}"
              {% if link.current %}aria-current="page"{% endif %}
            >
              {{ link.title | escape }}
            </a>
            <span class="header__ticker-separator" aria-hidden="true">/</span>
          {%- endfor -%}

          {%- comment -%} Brand name {%- endcomment -%}
          <span class="header__ticker-item header__ticker-item--brand">UNCREATED</span>
          <span class="header__ticker-separator" aria-hidden="true">/</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</nav>
