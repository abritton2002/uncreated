{% comment %}
  Renders a continuous scrolling ticker menu (sports bar style).
  Infinitely scrolls menu items from right to left.

  Usage:
  {% render 'header-ticker-menu' %}
{% endcomment %}

<nav class="header__ticker-menu" role="navigation" aria-label="Main navigation">
  <div class="header__ticker-container">
    <div class="header__ticker-track">
      {%- comment -%} Repeat content 6 times for seamless infinite scroll {%- endcomment -%}
      {%- for i in (1..6) -%}
        <div class="header__ticker-content"{% if i > 1 %} aria-hidden="true"{% endif %}>
          {%- for link in section.settings.menu.links -%}
            <a
              href="{{ link.url }}"
              class="header__ticker-item{% if link.current %} header__ticker-item--active{% endif %}"
              {% if link.current %}aria-current="page"{% endif %}
            >
              {{ link.title | escape }}
            </a>
            <span class="header__ticker-separator" aria-hidden="true">/</span>
          {%- endfor -%}
          {%- comment -%} Add brand message in the ticker {%- endcomment -%}
          <span class="header__ticker-item header__ticker-item--brand">UNCREATED</span>
          <span class="header__ticker-separator" aria-hidden="true">/</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</nav>

<script>
  // Pause ticker on hover, resume on mouseout
  document.addEventListener('DOMContentLoaded', function() {
    const ticker = document.querySelector('.header__ticker-track');
    if (!ticker) return;

    const container = ticker.closest('.header__ticker-menu');
    if (!container) return;

    container.addEventListener('mouseenter', function() {
      ticker.style.animationPlayState = 'paused';
    });

    container.addEventListener('mouseleave', function() {
      ticker.style.animationPlayState = 'running';
    });
  });
</script>
